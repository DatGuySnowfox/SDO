# Copy to .env (untracked — never commit real values) and fill in.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Generate a world id with: node -e "console.log(require('crypto').randomUUID())"
SDO_HOST_SECRET=
SDO_TICKET_SECRET=
SDO_WORLD_ID=
SDO_DIRECTORY_KEY=

# Public hostname players connect to (what the gateway hands out in tickets).
# Leave blank to auto-detect this host's public IP.
SDO_PUBLIC_HOST=
# Directory this server heartbeats into. Blank disables directory registration.
SDO_DIRECTORY_URL=
SDO_SERVER_NAME=
