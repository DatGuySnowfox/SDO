server {
    server_name sdo.harzgg.space;
    root /var/www/sdo.harzgg.space;
    index index.html;

    location / { try_files $uri $uri/ =404; }
    location = /404.html { internal; }
    error_page 404 /404.html;

    location ~* ^/downloads/.*\.zip$ {
        default_type application/zip;
        add_header Content-Disposition "attachment";
        add_header X-Content-Type-Options "nosniff" always;
    }

    location /downloads/ {
        default_type text/plain;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location ~* \.(?:css|js|png|jpg|jpeg|gif|svg|webp|ico)$ {
        expires 7d;
        add_header Cache-Control "public, no-transform";
    }

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    listen 443 ssl; # managed by Certbot
    listen [::]:443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/sdo.harzgg.space/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/sdo.harzgg.space/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot



















    # SDO_PROFILE_API_BEGIN
    location = /profile-api { return 301 /profile-api/; }
    # SDO_PROFILE_API_END

    # SDO_LAUNCHER_UPDATE_BEGIN
    location = /launcher-update.json {
        alias /var/www/sdo.harzgg.space/launcher-update.json;
        default_type application/json;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
    }
    location = /downloads/launcher-update.json {
        alias /var/www/sdo.harzgg.space/downloads/launcher-update.json;
        default_type application/json;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
    }
    # SDO_LAUNCHER_UPDATE_END

    include /etc/nginx/snippets/sdo-profile-api.conf;
}
server {
    if ($host = sdo.harzgg.space) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name sdo.harzgg.space;
    return 404; # managed by Certbot



















    # SDO_PROFILE_API_BEGIN
    location = /profile-api { return 301 /profile-api/; }
    location ^~ /profile-api/ {
        client_max_body_size 256m;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://127.0.0.1:27881/;
    }
    # SDO_PROFILE_API_END

    # SDO_LAUNCHER_UPDATE_BEGIN
    location = /launcher-update.json {
        alias /var/www/sdo.harzgg.space/launcher-update.json;
        default_type application/json;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
    }
    location = /downloads/launcher-update.json {
        alias /var/www/sdo.harzgg.space/downloads/launcher-update.json;
        default_type application/json;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
    }
    # SDO_LAUNCHER_UPDATE_END
}